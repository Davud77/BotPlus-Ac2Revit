{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ac2revit:manifest:1.0.0",
  "title": "Archicad to Revit manifest v1",
  "type": "object",
  "required": ["schemaVersion", "source", "units", "coordinates", "levels", "materials", "types", "elements"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "source": {"type": "object", "required": ["application", "projectId", "scope"], "properties": {
      "application": {"const": "Archicad"}, "projectId": {"type": "string", "format": "uuid"}, "scope": {"type": "string"}
    }},
    "units": {"type": "object", "required": ["length", "angle"], "properties": {"length": {"const": "m"}, "angle": {"const": "rad"}}},
    "coordinates": {"type": "object", "required": ["system", "transform"], "properties": {
      "system": {"const": "ArchicadProject"}, "transform": {"type": "object", "required": ["translation", "rotationRadians"], "properties": {
        "translation": {"$ref": "#/$defs/point"}, "rotationRadians": {"type": "number"}
      }}, "geolocation": {"type": "object"}
    }},
    "levels": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["key", "index", "name", "elevation"], "properties": {
      "key": {"type": "string", "minLength": 1}, "index": {"type": "integer"}, "name": {"type": "string"}, "elevation": {"type": "number"}, "raw": {"type": "object"}
    }}},
    "materials": {"type": "array", "items": {"type": "object"}},
    "surfaces": {"type": "array", "items": {"type": "object"}},
    "fills": {"type": "array", "items": {"type": "object"}},
    "penTables": {"type": "array", "items": {"type": "object"}},
    "types": {"type": "array", "items": {"type": "object", "required": ["key", "kind", "name", "layers"], "properties": {
      "key": {"type": "string", "minLength": 1}, "kind": {"enum": ["Wall", "Floor"]}, "name": {"type": "string"},
      "layers": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["width", "function", "materialKey"], "properties": {
        "width": {"type": "number", "minimum": 0}, "function": {"enum": ["Core", "Finish", "Other", "Membrane"]},
        "sourceFunction": {"enum": ["Core", "Finish", "Other"]}, "materialKey": {"type": "string"}
      }, "allOf": [{"if": {"properties": {"width": {"const": 0}}}, "then": {"properties": {"function": {"const": "Membrane"}}}}]}}
    }}},
    "elements": {"type": "array", "items": {"$ref": "#/$defs/element"}},
    "issues": {"type": "array"}, "manifestHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "point": {"type": "object", "required": ["x", "y", "z"], "additionalProperties": false, "properties": {
      "x": {"type": "number"}, "y": {"type": "number"}, "z": {"type": "number"}
    }},
    "edge": {"type": "object", "required": ["kind", "start", "end"], "properties": {
      "kind": {"enum": ["line", "arc"]}, "start": {"$ref": "#/$defs/point"}, "end": {"$ref": "#/$defs/point"}, "mid": {"$ref": "#/$defs/point"}
    }, "allOf": [{"if": {"properties": {"kind": {"const": "arc"}}}, "then": {"required": ["mid"]}}]},
    "loops": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/edge"}}},
    "element": {
      "type": "object", "required": ["sourceGuid", "kind", "levelKey", "mark", "dependencies", "status", "payload", "raw", "contentHash"],
      "properties": {
        "sourceGuid": {"type": "string", "format": "uuid"}, "kind": {"type": "string"}, "levelKey": {"type": "string"}, "mark": {"type": "string"},
        "dependencies": {"type": "array", "items": {"type": "string", "format": "uuid"}},
        "status": {"enum": ["ready", "needsMapping", "unsupported"]}, "reason": {"type": "string"},
        "raw": {"type": "object"}, "contentHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "payload": {"type": "object"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "Wall"}, "status": {"const": "ready"}}}, "then": {"properties": {"payload": {
          "required": ["curve", "typeKey", "height", "bottomOffset", "flipped", "referenceLine"], "properties": {
            "curve": {"$ref": "#/$defs/edge"}, "typeKey": {"type": "string"}, "height": {"type": "number", "exclusiveMinimum": 0},
            "bottomOffset": {"type": "number"}, "flipped": {"type": "boolean"}, "referenceLine": {"enum": ["Center", "Outside", "Inside", "CoreCenter", "CoreOutside", "CoreInside"]}
          }
        }}}},
        {"if": {"properties": {"kind": {"const": "Slab"}, "status": {"const": "ready"}}}, "then": {"properties": {"payload": {
          "required": ["loops", "typeKey", "topOffset"], "properties": {"loops": {"$ref": "#/$defs/loops"}, "typeKey": {"type": "string"}, "topOffset": {"type": "number"}}
        }}}},
        {"if": {"properties": {"kind": {"const": "Zone"}, "status": {"const": "ready"}}}, "then": {"properties": {"payload": {
          "required": ["loops", "point", "name", "number", "baseOffset"], "properties": {"loops": {"$ref": "#/$defs/loops"}, "point": {"$ref": "#/$defs/point"}}
        }}}}
      ]
    }
  }
}
