{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ac2revit.local/contracts/pipeline.schema.json",
  "title": "Prepared Archicad to Revit import pipeline",
  "type": "object",
  "required": ["pipelineFormat", "sourceManifest", "mapping", "gridsManifest", "columnNativeManifest", "columnNativeMapping", "columnBodies", "columnExtrusions", "columnTemplate", "beamBodies", "rectangularBeams", "beamFamily", "voidTemplate", "openingsPlan"],
  "properties": {
    "pipelineFormat": {"const": "ac2r.pipeline/1"},
    "sourceManifest": {"$ref": "#/$defs/path"},
    "mapping": {"$ref": "#/$defs/path"},
    "gridsManifest": {"$ref": "#/$defs/path"},
    "columnNativeManifest": {"$ref": "#/$defs/path"},
    "columnNativeMapping": {"$ref": "#/$defs/path"},
    "columnBodies": {"$ref": "#/$defs/path"},
    "columnExtrusions": {"$ref": "#/$defs/path"},
    "columnTemplate": {"$ref": "#/$defs/path"},
    "beamBodies": {"$ref": "#/$defs/path"},
    "rectangularBeams": {"$ref": "#/$defs/path"},
    "beamFamily": {"$ref": "#/$defs/path"},
    "voidTemplate": {"$ref": "#/$defs/path"},
    "openingsPlan": {"$ref": "#/$defs/path"},
    "wallBodies": {"$ref": "#/$defs/path"},
    "roomAuditLimit": {"type": "integer", "minimum": 0, "default": 20},
    "rebuildRooms": {"type": "boolean", "default": true},
    "nativeCutBeams": {"type": "boolean", "default": true},
    "columnBehavior": {"$ref": "#/$defs/path"},
    "roomSeparators": {"$ref": "#/$defs/path"},
    "hatchMapping": {"$ref": "#/$defs/path"},
    "hatchRules": {"$ref": "#/$defs/path"},
    "requireCompleteSeparatorCoverage": {"type": "boolean", "default": true},
    "enforceSourceSnapshot": {"type": "boolean", "default": false},
    "completeWallsFromIfc": {"type": "boolean", "default": false},
    "profileColumnMode": {"enum": ["auto", "native", "ifc"], "default": "auto"},
    "ifcCoordinateFrame": {"$ref": "#/$defs/path"},
    "supplementalBodiesPlan": {"$ref": "#/$defs/path"},
    "completeInitialWallJoins": {"type": "boolean", "default": false}
  },
  "$defs": {"path": {"type": "string", "minLength": 1, "description": "File path; relative paths resolve against pipeline.json, never the current shell directory."}},
  "additionalProperties": false
}
